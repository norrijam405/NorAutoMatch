{
  "name": "norautomatch-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Outbox-protected Express API engine, relay daemon, and BullMQ worker pool",
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "start:api": "node dist/server.js",
    "start:relay": "node dist/relay.js",
    "start:worker": "node dist/worker.js",
    "dev:api": "tsx watch src/server.ts",
    "dev:relay": "tsx watch src/relay.ts",
    "dev:worker": "tsx watch src/worker.ts"
  },
  "dependencies": {
    "bullmq": "^5.34.0",
    "express": "^4.21.2",
    "ioredis": "^5.4.2",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
