# Backend API engine, relay daemon
DATABASE_URL=postgres://app:app_secret@localhost:5432/norautomatch
PORT=4000

# Redis (queue + idempotency lock layer)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# Relay daemon tuning
OUTBOX_POLL_INTERVAL_MS=1000
OUTBOX_MAX_ATTEMPTS=5

# Worker pool tuning
WORKER_CONCURRENCY=5
IDEMPOTENCY_TTL_SECONDS=86400

# Frontend dev proxy target
API_PROXY_TARGET=http://localhost:4000
