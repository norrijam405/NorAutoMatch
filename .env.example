# Durable NorAutoMatch CRM database. Required before production lead intake is accepted.
# Use a PostgreSQL connection string supplied by the deployment environment.
NORAUTO_CRM_DATABASE_URL=

# Server-only HMAC secret used only to pseudonymize public network subjects for distributed abuse control.
# Production public intake fails closed when this is missing or shorter than 32 characters.
# This value does not authenticate a customer and must be different from every signing/session secret below.
NORAUTO_PUBLIC_ABUSE_HMAC_SECRET=

# Production abuse control must not trust client-spoofable proxy headers implicitly.
# Set NORAUTO_PUBLIC_NETWORK_SUBJECT_HEADER to exactly one deployment-controlled header after verifying
# that the trusted reverse proxy strips client-supplied copies and injects the authoritative network subject.
# Allowed values: x-forwarded-for or x-real-ip.
NORAUTO_PUBLIC_NETWORK_SUBJECT_HEADER=

# Deliberate trust activation for the deployment-controlled network header above.
# Leave blank unless ingress behavior has been independently verified. Required exact value:
# TRUST_DEPLOYMENT_PROXY_NETWORK_HEADERS
NORAUTO_TRUST_PROXY_NETWORK_HEADERS=

# Optional downstream CRM delivery target. Durable lead intake is committed to PostgreSQL first;
# the outbox delivery worker owns external delivery/retry rather than the customer request path.
# Compatible with approved Zapier, Make, n8n, HubSpot workflows, etc.
CRM_WEBHOOK_URL=

# Server-only current HMAC key for short-lived assertions accepted only by the internal CRM relay boundary.
# Use a random secret at least 32 characters long. Static NORAUTO_RELAY_TRIGGER_TOKEN bearer auth is legacy
# and is not accepted by the hardened relay route.
NORAUTO_RELAY_ASSERTION_SECRET=

# Optional previous relay assertion signing key used verification-only during a bounded rollover.
# It must be at least 32 characters, different from the current relay key, and removed after the maximum
# five-minute assertion lifetime plus deployment propagation is complete. New assertions use the current key only.
NORAUTO_RELAY_ASSERTION_PREVIOUS_SECRET=

# Server-only current HMAC key for short-lived assertions accepted only by the conversation-event gateway.
# Use a different random secret at least 32 characters long. Static NORAUTO_CONVERSATION_GATEWAY_TOKEN
# bearer auth is legacy and is not accepted by the hardened conversation route.
NORAUTO_CONVERSATION_GATEWAY_ASSERTION_SECRET=

# Optional previous conversation-gateway assertion signing key used verification-only during bounded rollover.
# It must be at least 32 characters, different from the current gateway key, and removed after the maximum
# five-minute assertion lifetime plus deployment propagation is complete. New assertions use the current key only.
NORAUTO_CONVERSATION_GATEWAY_ASSERTION_PREVIOUS_SECRET=

# Optional bounded number of outbox events processed per authenticated relay trigger.
# Default 10, hard maximum 50.
NORAUTO_RELAY_BATCH_SIZE=10

# Server-only current key used to verify short-lived manager session tokens from a trusted identity issuer.
# This app intentionally exposes no public manager-session issuer. Use a random secret at least
# 32 characters long and keep it outside browser/client bundles. Manager routes fail closed when absent.
NORAUTO_MANAGER_SESSION_SECRET=

# Optional previous manager-session signing key used only during a bounded key rollover.
# It must be at least 32 characters and different from the current secret. Remove it after the rollover
# window to immediately end acceptance of sessions signed with the old key.
NORAUTO_MANAGER_SESSION_PREVIOUS_SECRET=

# Every current/previous signing key and the public-abuse HMAC key must remain purpose-separated.
# Do not reuse a relay, conversation-gateway, manager-session, or abuse-control secret for another domain.

# Optional comma-separated manager session nonces to revoke before their natural expiration.
# Entries must be 16-256 characters; malformed or excessive configuration fails manager auth closed.
# This is a bounded application-level emergency control, not a replacement for the durable revocation ledger.
NORAUTO_MANAGER_REVOKED_SESSION_NONCES=

# Public production URL, e.g. https://norautomatch.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Inventory runtime mode. Safe default is demo.
# demo        = customer sees demonstration inventory only.
# live-shadow = customer still sees demo inventory while live Orr data is observed/tested separately.
# live-enabled = customer-visible live inventory; requires the exact activation value below.
NORAUTO_INVENTORY_MODE=demo

# Deliberate second gate for customer-visible live inventory.
# Leave blank unless the live inventory boundary has passed its required assurance/release gates.
# Required exact value when NORAUTO_INVENTORY_MODE=live-enabled:
# ENABLE_ORR_LIVE_CUSTOMER_INVENTORY
NORAUTO_LIVE_INVENTORY_ACTIVATION=

# Deliberate activation gate for the bounded purchase-estimate API.
# Safe/default state is blank/off. Merging or deploying endpoint code does not activate estimates.
# Required exact value only after endpoint security, claim-language, and deployment gates close:
# ENABLE_BOUNDED_PURCHASE_ESTIMATES
NORAUTO_PURCHASE_ESTIMATE_ACTIVATION=
