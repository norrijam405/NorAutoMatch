# Durable NorAutoMatch CRM database. Required before production lead intake is accepted.
# Use a PostgreSQL connection string supplied by the deployment environment.
NORAUTO_CRM_DATABASE_URL=

# Optional downstream CRM delivery target. Durable lead intake is committed to PostgreSQL first;
# the outbox delivery worker owns external delivery/retry rather than the customer request path.
# Compatible with approved Zapier, Make, n8n, HubSpot workflows, etc.
CRM_WEBHOOK_URL=

# Machine-only token used to invoke the internal outbox relay trigger.
# Use a random secret at least 32 characters long and never expose it to browser code.
NORAUTO_RELAY_TRIGGER_TOKEN=

# Machine-only token used to invoke the internal conversation event gateway.
# Use a random secret at least 32 characters long and never expose it to browser code.
# The internal gateway fails closed when this token is absent or too short.
NORAUTO_CONVERSATION_GATEWAY_TOKEN=

# Optional bounded number of outbox events processed per authenticated relay trigger.
# Default 10, hard maximum 50.
NORAUTO_RELAY_BATCH_SIZE=10

# Server-only current key used to verify short-lived manager session tokens from a trusted identity issuer.
# This app intentionally exposes no public manager-session issuer. Use a random secret at least
# 32 characters long and keep it outside browser/client bundles. Manager routes fail closed when absent.
NORAUTO_MANAGER_SESSION_SECRET=

# Optional previous manager-session signing key used only during a bounded key rollover.
# It must be at least 32 characters and different from the current secret. Remove it after the rollover
# window to immediately end acceptance of sessions signed with the old key.
NORAUTO_MANAGER_SESSION_PREVIOUS_SECRET=

# Optional comma-separated manager session nonces to revoke before their natural expiration.
# Entries must be 16-256 characters; malformed or excessive configuration fails manager auth closed.
# This is a bounded application-level emergency control, not a replacement for a centralized IdP/session store.
NORAUTO_MANAGER_REVOKED_SESSION_NONCES=

# Public production URL, e.g. https://norautomatch.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Inventory runtime mode. Safe default is demo.
# demo        = customer sees demonstration inventory only.
# live-shadow = customer still sees demo inventory while live Orr data is observed/tested separately.
# live-enabled = customer-visible live inventory; requires the exact activation value below.
NORAUTO_INVENTORY_MODE=demo

# Deliberate second gate for customer-visible live inventory.
# Leave blank unless the live inventory boundary has passed its required assurance/release gates.
# Required exact value when NORAUTO_INVENTORY_MODE=live-enabled:
# ENABLE_ORR_LIVE_CUSTOMER_INVENTORY
NORAUTO_LIVE_INVENTORY_ACTIVATION=

# Deliberate activation gate for the bounded purchase-estimate API.
# Safe/default state is blank/off. Merging or deploying endpoint code does not activate estimates.
# Required exact value only after endpoint security, claim-language, and deployment gates close:
# ENABLE_BOUNDED_PURCHASE_ESTIMATES
NORAUTO_PURCHASE_ESTIMATE_ACTIVATION=
